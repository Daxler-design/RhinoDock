<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- NOTE: installed Rhino uses 4.6; real repo requires C# 10 file-scoped namespaces. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Template/**/*.cs" />
    <EmbeddedResource Include="Template/**" />
    <Compile Remove="ExtensionTemplate/**/*.cs" />
    <EmbeddedResource Include="ExtensionTemplate/**" />
    <EmbeddedResource Include="../../examples/ViewportSliders/ViewportSliders.cs;../../examples/ViewportSliders/ViewportSliders.csproj;../../examples/ViewportSliders/README.md" LogicalName="rhDock.Core.ExtensionTemplate.ViewportSliders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/ViewportSliderScript/Components/ViewportSliderScript.cs" LogicalName="rhDock.Core.ExtensionTemplate.ViewportSliders.SampleScript.cs.txt" />
  </ItemGroup>
</Project>

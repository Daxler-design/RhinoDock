<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.6.11</Version>
    <Description>Rhino 8 host for single-Script C# Workspaces</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../rhDock.Core/rhDock.Core.csproj" />
    <ProjectReference Include="../rhDock.Agents/rhDock.Agents.csproj" />
    <ProjectReference Include="../rhDock.Cli/rhDock.Cli.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="DiffPlex" Version="1.9.0" GeneratePathProperty="true" />
    <PackageReference Include="RhinoCommon" Version="8.31.26126.13431" Private="false" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.31.26126.13431" Private="false" ExcludeAssets="runtime" />
    <EmbeddedResource Include="../../frontend/dist/index.html" LogicalName="rhDock.Frontend.index.html" />
    <EmbeddedResource Include="Assets/PanelIcon.ico" LogicalName="rhDock.PanelIcon.ico" />
  </ItemGroup>
  <!-- A class library does not copy package assemblies; ship DiffPlex next to the plug-in, but not Roslyn, which Rhino provides. -->
  <Target Name="CopyDiffPlex" AfterTargets="Build">
    <Copy SourceFiles="$(PkgDiffPlex)/lib/net6.0/DiffPlex.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyHostCli" AfterTargets="Build">
    <!-- Ask the CLI project where it built: with an isolated build (artifacts path) a fixed bin/ path copied a stale CLI. -->
    <MSBuild Projects="../rhDock.Cli/rhDock.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="HostCliTarget" />
    </MSBuild>
    <PropertyGroup><HostCliDir>@(HostCliTarget->'%(RootDir)%(Directory)')</HostCliDir></PropertyGroup>
    <ItemGroup><HostCliFiles Include="$(HostCliDir)rhdock.dll;$(HostCliDir)rhdock.deps.json;$(HostCliDir)rhdock.runtimeconfig.json" /></ItemGroup>
    <Error Condition="!Exists('$(HostCliDir)rhdock.dll')" Text="The rhDock CLI was not built at $(HostCliDir)." />
    <Copy SourceFiles="@(HostCliFiles)" DestinationFolder="$(OutDir)cli" SkipUnchangedFiles="true" />
    <GetFileHash Files="$(HostCliDir)rhdock.dll;$(OutDir)cli/rhdock.dll"><Output TaskParameter="Items" ItemName="HostCliHashes" /></GetFileHash>
    <Error Condition="'@(HostCliHashes->'%(FileHash)'->Distinct()->Count())' != '1'" Text="The plug-in's cli/rhdock.dll differs from the CLI just built." />
  </Target>
  <!--
    Stages the complete Yak payload when YakDir is set (dotnet build -c Release -p:YakDir=...), copied from this build's real outputs
    rather than by hand, then checks by hash that the staged CLI and plug-in are the ones just built and that the manifest version is
    the project Version. A hand copy once packaged a stale CLI for several releases without any error.
  -->
  <Target Name="StageYak" AfterTargets="Build" DependsOnTargets="CopyDiffPlex;CopyHostCli" Condition="'$(YakDir)' != ''">
    <!-- A relative YakDir is relative to where the build was started, as on the command line. -->
    <PropertyGroup><YakOut>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine('$(MSBuildStartupDirectory)', '$(YakDir)'))'))'))</YakOut></PropertyGroup>
    <ItemGroup>
      <YakOld Include="$(YakOut)*.yak;$(YakOut)cli/**" />
      <YakFiles Include="$(TargetPath);$(OutDir)rhDock.Core.dll;$(OutDir)rhDock.Agents.dll;$(OutDir)DiffPlex.dll;$(OutDir)rhDock.Rhino.deps.json;../../tools/yak/manifest.yml;../../THIRD-PARTY-NOTICES.md" />
    </ItemGroup>
    <!-- Check the version before touching YakDir, so a failed check leaves no half-staged payload. -->
    <ReadLinesFromFile File="../../tools/yak/manifest.yml"><Output TaskParameter="Lines" ItemName="YakManifest" /></ReadLinesFromFile>
    <PropertyGroup><YakManifestText>@(YakManifest, ' ')</YakManifestText></PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(YakManifestText)', 'version:\s*$(Version.Replace('.', '\.'))\b'))" Text="tools/yak/manifest.yml must have version: $(Version)." />
    <Delete Files="@(YakOld)" />
    <Copy SourceFiles="@(YakFiles)" DestinationFolder="$(YakOut)" />
    <Copy SourceFiles="@(HostCliFiles)" DestinationFolder="$(YakOut)cli" />
    <GetFileHash Files="$(HostCliDir)rhdock.dll;$(YakOut)cli/rhdock.dll"><Output TaskParameter="Items" ItemName="YakCliHashes" /></GetFileHash>
    <GetFileHash Files="$(TargetPath);$(YakOut)$(TargetFileName)"><Output TaskParameter="Items" ItemName="YakRhpHashes" /></GetFileHash>
    <Error Condition="'@(YakCliHashes->'%(FileHash)'->Distinct()->Count())' != '1'" Text="The staged cli/rhdock.dll differs from the CLI just built." />
    <Error Condition="'@(YakRhpHashes->'%(FileHash)'->Distinct()->Count())' != '1'" Text="The staged $(TargetFileName) differs from the plug-in just built." />
    <Message Importance="high" Text="Yak payload staged and checked in $(YakOut); run yak build --platform any there." />
  </Target>
  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild" Condition="!Exists('../../frontend/dist/index.html')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="../../frontend" />
    <Exec Command="npm run build" WorkingDirectory="../../frontend" />
  </Target>
</Project>

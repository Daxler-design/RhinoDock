<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(RhinoAssemblyDir)' == ''">
    <RhinoAssemblyDir>$(ProgramFiles)/Rhino 8/System</RhinoAssemblyDir>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RhinoAssemblyDir)' == ''">
    <RhinoAssemblyDir>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Resources</RhinoAssemblyDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoAssemblyDir)/RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
